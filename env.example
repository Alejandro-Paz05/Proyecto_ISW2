# ============================================
# AKARI STUDIO — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_ a propósito: todo el
# acceso a Supabase ocurre en el servidor (pages/api/), nunca en el
# navegador. Una variable NEXT_PUBLIC_ queda incrustada en el código
# que se descarga el usuario y cualquiera puede leerla.
#
# Dónde encontrarlas: en Supabase, Project Settings > Data API (la URL)
# y Project Settings > API Keys (la clave).

# URL del proyecto (ej. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Secret key, del sistema nuevo de claves de Supabase. Salta Row Level
# Security, así que NUNCA debe subirse al repositorio ni exponerse en el
# navegador. Las claves legacy basadas en JWT están desactivadas en este
# proyecto y ya no sirven. El nombre de la variable viene de cuando se
# usaba la clave service_role; se conserva para no tener que tocar las
# variables de cada entorno de Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel de administración, en /admin.
# Mínimo 8 caracteres. Sin esta variable el panel queda inaccesible,
# que es el comportamiento correcto: nunca se abre sin protección.
ADMIN_PASSWORD=
