# ============================================
# AKARI STUDIO — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================
#
# Solo dos variables llevan el prefijo NEXT_PUBLIC_, y es a propósito: las
# que el navegador necesita para iniciar sesión con Supabase Auth. Una
# variable NEXT_PUBLIC_ queda incrustada en el código que descarga el
# usuario y cualquiera puede leerla, así que nunca puede ser un secreto.
# Todo el acceso a los datos sigue ocurriendo en el servidor (pages/api/).
# Ver docs/adr/ADR-004.
#
# Dónde encontrarlas: en Supabase, Project Settings > Data API (la URL)
# y Project Settings > API Keys (la clave).

# URL del proyecto (ej. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Secret key, del sistema nuevo de claves de Supabase. Salta Row Level
# Security, así que NUNCA debe subirse al repositorio ni exponerse en el
# navegador. Las claves legacy basadas en JWT están desactivadas en este
# proyecto y ya no sirven. El nombre de la variable viene de cuando se
# usaba la clave service_role; se conserva para no tener que tocar las
# variables de cada entorno de Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Para iniciar sesión desde el navegador. La URL es la misma que
# SUPABASE_URL. La clave es la Publishable key (Project Settings > API
# Keys): pública por diseño, porque lo que protege los datos es RLS, no
# esconder la clave. Nunca pongas acá la Secret key.
#
# Sin estas dos, las cuentas no funcionan y el panel sigue abriéndose con
# ADMIN_PASSWORD, igual que antes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos push de pedidos nuevos, para el teléfono de quien atiende el panel.
#
# Son un par: la pública la usa el navegador para suscribirse y la privada
# firma cada aviso desde el servidor. Se generan una sola vez con
# `npx web-push generate-vapid-keys` y no se vuelven a tocar: cambiarlas
# invalida todas las suscripciones que ya existen, y cada dispositivo tendría
# que volver a activarlas.
#
# Sin estas variables, los avisos simplemente no se ofrecen. Nada más deja de
# funcionar: el pedido se registra igual.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A quién escribirle si un servicio de push necesita reportar un problema con
# estos envíos. Es parte del estándar: un mailto: o una URL.
VAPID_CONTACTO=

# Contraseña compartida del panel de la tienda, en /akaristudio/admin.
# Mínimo 8 caracteres.
#
# TEMPORAL: sirve mientras se pasa a cuentas con rol. Abre sesión como
# dueña. Se retira cuando la dueña tenga su propia cuenta (lib/sesion.js).
ADMIN_PASSWORD=
