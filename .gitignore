# Dependencias
/node_modules

# Next.js
/.next/
/out/

# Producción
/build

# Variables de entorno
.env
.env.local
.env*.local

# Archivos de Vercel
.vercel

# Cobertura de pruebas.
#
# El reporte HTML (lcov-report/) son cientos de archivos generados y no se
# versiona. Los dos resúmenes sí: son los artefactos que leen las
# herramientas externas —lcov.info lo consume SonarCloud, y
# coverage-summary.json permite consultar el porcentaje sin correr las
# pruebas— y tenerlos en el repo hace que la cifra sea auditable en vez de
# depender de que alguien confíe en una captura de pantalla.
/coverage/*
!/coverage/lcov.info
!/coverage/coverage-summary.json

# Pruebas E2E.
#
# Todo lo que deja Playwright al correr es reproducible corriéndolo otra vez:
# el informe HTML, las trazas y las capturas de un fallo. En el pipeline se
# guardan como artefacto de la corrida, que es donde sirven.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
