# ============================================
# AKARI STUDIO - Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ============================================

# Supabase (https://supabase.com)
# Crea un proyecto gratuito y copia estos valores desde
# Project Settings > API Keys
# IMPORTANTE: Usa la clave "anon" (Legacy API Keys, empieza con eyJ...),
# NO la "publishable" (no permite escritura de pedidos)
NEXT_PUBLIC_SUPABASE_URL=tu_url_de_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon
